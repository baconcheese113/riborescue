nextflow_pipeline {

    name "RiboRescue entry workflows"
    script "main.nf"

    test("SCORE triages the fixture variants") {
        when {
            params {
                step = "score"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            def triaged = path("$outputDir/triage/triaged.tsv").readLines()
            assert triaged.size() == 6
            assert triaged[0].endsWith("triage_class\tapplies\treason")
            assert triaged.count { it.contains("supported_nonsense") } == 2
            assert triaged.any { it.startsWith("DMD:") && it.contains("unsupported_transcript") }
        }
    }

    test("TRAIN validates the labels it will fit against") {
        when {
            params {
                step = "train"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/labels/labels.log").text.contains("3 labels, 1 at the assay ceiling")
            assert path("$outputDir/handoff/handoff.log").text.contains("nf-core/riboseq 1.2.0")
        }
    }

    test("READS trims both library types and reports raw against cleaned") {
        when {
            params {
                step = "reads"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            def summary = path("$outputDir/qc/trim_summary.tsv").readLines()
            assert summary.size() == 3
            assert summary[0].startsWith("sample\treads_raw\treads_cleaned")

            // The footprint library reaches its linker on every read; the transcriptome library
            // only on the fragments shorter than the read, and is not held to a floor for it.
            def rates = summary.drop(1).collectEntries { line ->
                def field = line.split("\t")
                [(field[0]): field[5] as double]
            }
            assert rates["riboseq_test"] == 1.0
            assert rates["rnaseq_test"] < 0.5

            assert path("$outputDir/qc/multiqc_report.html").exists()
            assert path("$outputDir/trimmed/riboseq_test_1.trimmed.fastq.gz").exists()
            assert path("$outputDir/trimmed/rnaseq_test_2.trimmed.fastq.gz").exists()
        }
    }

    test("a library whose declared adapter is absent fails rather than trimming nothing") {
        when {
            params {
                step = "reads"
                samplesheet = "$projectDir/tests/data/staged_runs_wrong_adapter.tsv"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert workflow.trace.failed().any { it.name.contains("TRIM_SUMMARY") }
        }
    }

    test("the amenability workflow names every input it is missing") {
        when {
            params {
                step = "amenability"
                outdir = "$outputDir"
            }
        }
        then {
            // The inputs are checked before any work starts, so nothing should have run at all.
            assert workflow.failed
            assert workflow.trace.succeeded().isEmpty()
            assert workflow.trace.failed().isEmpty()
        }
    }

    test("a handoff naming an absent upstream output fails the run") {
        when {
            params {
                step = "score"
                handoff = "$projectDir/tests/data/handoff.json"
                results_root = "$projectDir/tests/data"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.failed
            assert workflow.trace.failed().any { it.name.contains("VALIDATE_HANDOFF") }
            assert workflow.trace.succeeded().isEmpty()
        }
    }
}
