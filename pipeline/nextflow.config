manifest {
    name            = 'riborescue'
    author          = 'RiboRescue'
    description     = 'Match nonsense variants to candidate readthrough therapies.'
    homePage        = 'https://github.com/baconcheese113/riborescue'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

params {
    step              = null
    samplesheet       = null
    // Footprints are 28-32 nt, so a bound fit to a transcriptome library would discard the signal.
    min_length_riboseq = 20
    min_length_rnaseq  = 30
    quality_cutoff     = 20
    genome             = null
    annotation         = null
    contaminants       = null
    rdna               = null
    // STAR sizes its suffix array index to the reference; the default overshoots a small one.
    contaminant_sa_index_nbases = 11
    contaminant_index_store = "${projectDir}/../data/contaminants"
    // A dense human index needs more memory than a 30 GB machine has.
    genome_sa_sparse   = 2
    sjdb_overhang      = 100
    // Beside the other fetched inputs, which is where the ignore rules already expect bulk data.
    star_index_store   = "${projectDir}/../data/star"
    handoff           = null
    results_root      = null
    labels            = null
    variants          = null
    clinvar           = null
    mane_annotation   = null
    mane_transcripts  = null
    mane_proteins     = null
    training          = null
    held_out          = null
    outdir            = 'results'
    upstream_pipeline = 'nf-core/riboseq'
    upstream_revision = '1.2.0'
    riborescue_image  = 'ghcr.io/baconcheese113/riborescue:0.1.0'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = params.riborescue_image
    }
    local {
        // riborescue comes from the surrounding Pixi environment
        process.container = null
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
