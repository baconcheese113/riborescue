process {
    errorStrategy = 'terminate'

    // without pipefail a failing command that feeds a pipe reports its successor's exit status
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Requests are measured rather than guessed. Peak resident memory, on the full ClinVar release
    // and MANE 1.5: variant extraction 0.32 GB, context placement 0.94 GB, scoring 0.89 GB,
    // suppressor coverage 0.32 GB. The allowances double the largest of those.
    withLabel: process_single {
        cpus   = 1
        memory = 1.GB
        time   = 15.m
    }
    withLabel: process_annotation {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }
}
