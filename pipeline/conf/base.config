process {
    errorStrategy = 'terminate'

    // without pipefail a failing command that feeds a pipe reports its successor's status
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Peak resident memory over the full ClinVar release is 0.94 GB at its highest, placing
    // variants on transcripts; the rest sit near 0.3 GB.
    withLabel: process_single {
        cpus   = 1
        memory = 1.GB
        time   = 15.m
    }
    withLabel: process_annotation {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }
    withLabel: process_reads {
        cpus   = 4
        memory = 4.GB
        time   = 4.h
    }
}
