/*
 * A minimal end-to-end run over the committed fixtures.
 *
 *   nextflow run pipeline --step score -profile test,local
 */

params {
    handoff      = "${projectDir}/tests/data/handoff.json"
    results_root = "${projectDir}/tests/data/upstream"
    labels       = "${projectDir}/tests/data/labels.tsv"
    variants     = "${projectDir}/tests/data/variants.tsv"
    samplesheet  = "${projectDir}/tests/data/staged_runs.tsv"
    outdir       = 'results/test'
}
