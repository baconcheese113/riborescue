!/results/kinetics/gse144140/codon_occupancy.p.published.tsv
!/results/kinetics/permutation_null/familywise.tsv

# Data — fetched from public sources, never committed. Anchored, so test fixtures under
# pipeline/tests/data stay in git
/data/

# Docs — the decision records and the evidence behind a human gate are tracked; design documents
# and course material stay local. Compact course results are selected under results/.
/docs/*
!/docs/decisions/
!/docs/figures/
/docs/figures/*
!/docs/figures/*/
!/docs/figures/*/periodicity.png
!/docs/figures/*/psite_summary.tsv

# OS / editor — settings hold machine-local paths; only the extension list is shared
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# External tool checkouts (cloned at pinned commits by scripts)
vendor/
