# Pixi — project-local environments, never committed; the config travels with the repo so the
# post-link scripts Bioconductor data packages need run on a clean install
.pixi/*
!.pixi/config.toml

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/

# Nextflow
.nextflow/
.nf-test/
.nf-test.log
.nextflow.log*
work/
results/

# Data — fetched from public sources, never committed. Anchored, so test fixtures under
# pipeline/tests/data stay in git
/data/

# Docs — the decision records and the evidence behind a human gate are tracked; design documents
# and course material stay local
/docs/*
!/docs/decisions/
!/docs/figures/
/docs/figures/*
!/docs/figures/*/
!/docs/figures/*/periodicity.png
!/docs/figures/*/psite_summary.tsv

# OS / editor — settings hold machine-local paths; only the extension list is shared
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
