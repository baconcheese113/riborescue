# Pixi — project-local environments, never committed; the config travels with the repo so the
# post-link scripts Bioconductor data packages need run on a clean install
.pixi/*
!.pixi/config.toml

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/

# Nextflow
.nextflow/
.nf-test/
.nf-test.log
.nextflow.log*
work/
/pipeline/results/
/results/**
!/results/**/
!/results/README.md
!/results/evaluation.tsv
!/results/experiments.tsv
!/results/landscape_summary.tsv
!/results/reads/qc/alignment_summary.tsv
!/results/reads/qc/course_qc_summary.tsv
!/results/reads/qc/alignment_metrics.png
!/results/reads/qc/multiqc_report.html
!/results/reads/qc/pre_post_cleaning.png
!/results/reads/qc/qc_overview.png
!/results/reads/qc/trim_summary.tsv
!/results/reads/qc/multiqc_data/multiqc_general_stats.txt
!/results/rnaseq/composition.tsv
!/results/rnaseq/counts.tsv.summary
!/results/rnaseq/top_expressed.png
!/results/rnaseq/top_expressed.tsv
!/results/rnaseq/top_expressed_nuclear.png
!/results/rnaseq/top_expressed_nuclear.tsv
!/results/rnaseq/tpm.tsv
